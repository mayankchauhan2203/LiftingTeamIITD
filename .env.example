# Supabase (public — safe to expose)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...

# IITD OAuth client ID (public — used in PKCE redirect)
VITE_IITD_CLIENT_ID=your_iitd_client_id

# Express server base URL (leave blank for local dev proxy)
# On production: https://your-server.com/api
VITE_SERVER_URL=

# ── Server-side only (never commit real values) ──────────────────────────
IITD_CLIENT_ID=your_iitd_client_id
IITD_CLIENT_SECRET=your_iitd_client_secret
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...
SERVER_PORT=3001
